)"
RPP_TOLERANCE="$(
    ros2 param get \
        /rpp_controller \
        waypoint_tolerance_m
)"

printf '%s\n' \
    "$TG_SPACING" \
    "$MM_TOLERANCE" \
    "$MM_HOLD" \
    "$MM_STATIONARY" \
    "$RPP_CRUISE" \
    "$RPP_MINIMUM" \
    "$RPP_ALIGNMENT" \
    "$RPP_ALIGNMENT_RECOVERY" \
    "$RPP_XTRACK" \
    "$RPP_TERMINAL" \
    "$RPP_FINAL" \
    "$RPP_CLOSE" \
    "$BRIDGE_MAXIMUM" \
    "$RPP_MAX_YAW" \
    "$RPP_MIN_YAW" \
    "$RPP_PIVOT_KP" \
    "$RPP_PIVOT_ENTER" \
    "$RPP_PIVOT_RELEASE" \
    "$RPP_PATH_CORRECTION" \
    "$RPP_SEGMENT_CORRECTION" \
    "$RPP_XTRACK_CORRECTION" \
    "$RPP_XTRACK_ENTER" \
    "$RPP_XTRACK_EXIT" \
    "$RPP_XTRACK_LOOKAHEAD" \
    "$RPP_TERMINAL_RECOVERY_CORRECTION" \
    "$RPP_XTRACK_PREDICTION" \
    "$RPP_XTRACK_RATE_ALPHA" \
    "$RPP_XTRACK_SLEW" \
    "$RPP_XTRACK_NEUTRAL_BAND" \
    "$RPP_TERMINAL_LOOKAHEAD_MIN" \
    "$BRIDGE_MAX_YAW" \
    "$RPP_TOLERANCE"

assert_ros_double() {
    local label="$1"
    local output="$2"
    local expected="$3"

    ROS_PARAM_OUTPUT="$output" \
    ROS_PARAM_EXPECTED="$expected" \
    python3 - "$label" <<'PY'
import math
import os
import re
import sys

label = sys.argv[1]
output = os.environ["ROS_PARAM_OUTPUT"]
expected = float(os.environ["ROS_PARAM_EXPECTED"])

matches = re.findall(
    r"[-+]?(?:\d+(?:\.\d*)?|\.\d+)(?:[eE][-+]?\d+)?",
    output,
)
if not matches:
    raise SystemExit(f"ABORT: unable to parse {label}: {output!r}")

actual = float(matches[-1])
if not math.isclose(actual, expected, rel_tol=0.0, abs_tol=1.0e-9):
    raise SystemExit(
        f"ABORT: {label} is {actual}, expected {expected}"
    )
PY
}

assert_ros_double "trajectory spacing" "$TG_SPACING" 0.05
assert_ros_double "mission marking tolerance" "$MM_TOLERANCE" 0.03
assert_ros_double "mission marking hold" "$MM_HOLD" 3.0
assert_ros_double "stationary speed tolerance" "$MM_STATIONARY" 0.01

assert_ros_double "RPP cruise speed" "$RPP_CRUISE" 0.40
assert_ros_double "RPP minimum speed" "$RPP_MINIMUM" 0.40
assert_ros_double "RPP segment alignment speed" "$RPP_ALIGNMENT" 0.40
assert_ros_double \
    "RPP segment alignment recovery speed" \
    "$RPP_ALIGNMENT_RECOVERY" \
    0.40
assert_ros_double "RPP cross-track recovery speed" "$RPP_XTRACK" 0.40
assert_ros_double "RPP terminal speed" "$RPP_TERMINAL" 0.40
assert_ros_double "RPP final approach speed" "$RPP_FINAL" 0.40
assert_ros_double "RPP close recovery speed" "$RPP_CLOSE" 0.40
assert_ros_double "cmd_vel_bridge maximum speed" "$BRIDGE_MAXIMUM" 0.40
assert_ros_double "RPP maximum yaw rate" "$RPP_MAX_YAW" 0.20
assert_ros_double "RPP minimum yaw rate" "$RPP_MIN_YAW" 0.06
assert_ros_double "RPP pivot yaw Kp" "$RPP_PIVOT_KP" 1.00
assert_ros_double "RPP native pivot enter" "$RPP_PIVOT_ENTER" 45.0
assert_ros_double "RPP native pivot release" "$RPP_PIVOT_RELEASE" 12.0
assert_ros_double \
    "RPP path correction limit" \
    "$RPP_PATH_CORRECTION" \
    12.0
assert_ros_double \
    "RPP segment correction limit" \
    "$RPP_SEGMENT_CORRECTION" \
    12.0
assert_ros_double \
    "RPP xtrack correction limit" \
    "$RPP_XTRACK_CORRECTION" \
    20.0
assert_ros_double \
    "RPP xtrack recovery enter" \
    "$RPP_XTRACK_ENTER" \
    0.01
assert_ros_double \
    "RPP xtrack recovery exit" \
    "$RPP_XTRACK_EXIT" \
    0.005
assert_ros_double \
    "RPP xtrack recovery lookahead" \
    "$RPP_XTRACK_LOOKAHEAD" \
    0.20
assert_ros_double \
    "RPP terminal recovery correction limit" \
    "$RPP_TERMINAL_RECOVERY_CORRECTION" \
    20.0
assert_ros_double \
    "RPP xtrack prediction time" \
    "$RPP_XTRACK_PREDICTION" \
    0.45
assert_ros_double \
    "RPP xtrack rate filter alpha" \
    "$RPP_XTRACK_RATE_ALPHA" \
    0.35
assert_ros_double \
    "RPP xtrack correction slew" \
    "$RPP_XTRACK_SLEW" \
    60.0
assert_ros_double \
    "RPP xtrack neutral crossing band" \
    "$RPP_XTRACK_NEUTRAL_BAND" \
    0.02
assert_ros_double \
    "RPP terminal recovery minimum lookahead" \
    "$RPP_TERMINAL_LOOKAHEAD_MIN" \
    0.15
assert_ros_double "cmd_vel_bridge compatibility yaw rate" "$BRIDGE_MAX_YAW" 0.20

assert_ros_double "RPP waypoint tolerance" "$RPP_TOLERANCE" 0.03

echo "0.40 m/s + pivot 45deg -> drive 12deg + damped 10mm/20deg xtrack recovery verified."


echo
echo "===== RTK AND GPS CHECK ====="

RTK_HEALTH="$(
    timeout 5s ros2 topic echo \
        /rtk_correction_bridge/healthy \
        --once 2>/dev/null || true
)"
echo "$RTK_HEALTH"

if ! grep -q "data: true" <<<"$RTK_HEALTH"; then
    echo "ABORT: RTK correction bridge is not healthy"
    exit 1
fi

GPS_FIX="$(
    timeout 5s ros2 topic echo \
        /mavros/gpsstatus/gps1/raw \
        --once \
        --field fix_type 2>/dev/null || true
)"
echo "GPS fix type: $GPS_FIX"

if ! grep -q "^6$" <<<"$GPS_FIX"; then
    echo "ABORT: GPS fix_type is not 6"
    exit 1
fi


echo
echo "===== PREPARE PRODUCTION SOURCE MISSION ====="

PREPARE_RESPONSE="$(
    api_request POST /api/mission/prepare
)"
printf '%s\n' "$PREPARE_RESPONSE" | python3 -m json.tool

SOURCE_TOTAL="$(
    printf '%s' "$PREPARE_RESPONSE" |
    json_get mission.total_points
)"

if [[ -z "$SOURCE_TOTAL" || "$SOURCE_TOTAL" -lt 2 ]]; then
    echo "ABORT: prepared mission has fewer than two marking points"
    exit 1
fi


echo
echo "===== START TEST-PATH SUPERVISOR ====="

rm -rf "$RUNTIME_DIR"
mkdir -p "$RUNTIME_DIR"

python3 "$SUPERVISOR" \
    --spacing-m 0.05 \
    --position-tolerance-m 0.03 \
    --hold-required-sec 3.0 \
    --heading-tolerance-deg "$HEADING_TOLERANCE_DEG" \
    --odom-timeout-sec 0.50 \
    --ready-file "$READY_FILE" \
    --result-file "$RESULT_FILE" \
    --event-file "$EVENT_FILE" \
    >"$SUPERVISOR_LOG" 2>&1 &

SUPERVISOR_PID=$!
TEST_PATH_STARTED=1
printf '%s\n' "$SUPERVISOR_PID" > "$SUPERVISOR_PID_FILE"


echo
echo "===== WAIT FOR TEMPORARY C->P1->P2 PATH ====="

for _ in $(seq 1 300); do
    if [[ -f "$RESULT_FILE" ]]; then
        break
    fi
    if [[ -f "$READY_FILE" ]]; then
        break
    fi
    if ! kill -0 "$SUPERVISOR_PID" 2>/dev/null; then
        echo "ABORT: test supervisor exited unexpectedly"
        cat "$SUPERVISOR_LOG" || true
        exit 1
    fi
    sleep 0.1
done

if [[ -f "$RESULT_FILE" && ! -f "$READY_FILE" ]]; then
    cat "$RESULT_FILE" | python3 -m json.tool
    echo "ABORT: supervisor could not build/load test path"
    exit 1
fi

if [[ ! -f "$READY_FILE" ]]; then
    echo "ABORT: timed out waiting for temporary test path"
    cat "$SUPERVISOR_LOG" || true
    exit 1
fi

cat "$READY_FILE" | python3 -m json.tool

MAX_SPACING="$(
    cat "$READY_FILE" |
    json_get maximum_generated_spacing_m
)"

python3 - "$MAX_SPACING" <<'PY'
import sys

spacing = float(sys.argv[1])
if spacing > 0.05 + 1.0e-9:
    raise SystemExit(
        f"Generated spacing is too large: {spacing}"
    )
PY


echo
echo "===== CONFIRM TWO-POINT MISSION MANAGER STATE ====="

STATUS_RESPONSE="$(
    api_request GET /api/mission/status
)"
printf '%s\n' "$STATUS_RESPONSE" | python3 -m json.tool

TEST_TOTAL="$(
    printf '%s' "$STATUS_RESPONSE" |
    json_get mission.total_points
)"
TEST_READY="$(
    printf '%s' "$STATUS_RESPONSE" |
    json_get mission.ready
)"
TEST_STATE="$(
    printf '%s' "$STATUS_RESPONSE" |
    json_get mission.state
)"

if [[ "$TEST_TOTAL" != "2" ]]; then
    echo "ABORT: mission manager did not load exactly P1 and P2"
    exit 1
fi

if [[ "$TEST_READY" != "true" || "$TEST_STATE" != "READY" ]]; then
    echo "ABORT: mission manager is not READY with the test path"
    exit 1
fi


START_LINE=$(( $(wc -l < "$LOG_FILE") + 1 ))


echo
echo "===== START THROUGH PRODUCTION BACKEND ====="

START_RESPONSE="$(
    api_request POST /api/mission/start
)"
printf '%s\n' "$START_RESPONSE" | python3 -m json.tool


echo
echo "===== WAIT FOR ARMED OFFBOARD ====="

ARMED_OFFBOARD=0

for _ in $(seq 1 30); do
    STATE="$(
        timeout 4s ros2 topic echo \
            /mavros/state \
            --once 2>/dev/null || true
    )"

    if grep -q "armed: true" <<<"$STATE" &&
       grep -q "mode: OFFBOARD" <<<"$STATE"; then
        echo "$STATE"
        ARMED_OFFBOARD=1
        break
    fi

    sleep 0.5
done

if [[ "$ARMED_OFFBOARD" -ne 1 ]]; then
    echo "ABORT: PX4 did not reach armed OFFBOARD"
    exit 1
fi


echo
echo "===== TEST RUNNING ====="
echo "Do not move the rover or either GNSS antenna."
echo "Physical E-stop must remain ready."

START_EPOCH="$(date +%s)"

while true; do
    sleep 0.2

    if [[ -f "$RESULT_FILE" ]]; then
        FINAL_RESULT="$(
            cat "$RESULT_FILE" |
            json_get result
        )"
        break
    fi

    NEW_LOG="$(
        sed -n "${START_LINE},\$p" "$LOG_FILE"
    )"

    if grep -qiE \
        "MARKING CAPTURE MISSED / SAFE HOLD|SAFE HOLD|entered ERROR|MISSION ERROR" \
        <<<"$NEW_LOG"; then
        FINAL_RESULT="SAFE_HOLD_OR_ERROR"
        break
    fi

    NOW_EPOCH="$(date +%s)"
    ELAPSED=$((NOW_EPOCH - START_EPOCH))

    if (( ELAPSED >= TEST_TIMEOUT_SEC )); then
        FINAL_RESULT="TIMEOUT"
        break
    fi

    if (( ELAPSED > 0 && ELAPSED % 5 == 0 )); then
        if [[ "${LAST_PRINTED_ELAPSED:-}" != "$ELAPSED" ]]; then
            LAST_PRINTED_ELAPSED="$ELAPSED"

            echo
            echo "===== RUNNING: ${ELAPSED} SECONDS ====="

            sed -n "${START_LINE},\$p" "$LOG_FILE" |
            grep -E \
                "STRAIGHT SEGMENT GOAL|SEGMENT ALIGNMENT|SEGMENT ALIGNED|ABSOLUTE YAW PIVOT|50MM LOOKAHEAD|EXACT MARKING CONVERGENCE|MARKING CAPTURE|MARKING FINAL|Holding at marking|completed|MISSION COMPLETED|ERROR" |
            tail -n 25 || true

            api_request GET /api/mission/status |
            python3 -c '
import json
import sys

payload = json.load(sys.stdin)["mission"]

print(
    "state={state} active={active} completed={completed}/2 "
    "marking_active={marking} hold={hold:.2f}/{required:.2f}".format(
        state=payload.get("state"),
        active=payload.get("active_point_id"),
        completed=payload.get("completed_points", 0),
        marking=payload.get("marking_active", False),
        hold=float(payload.get("hold_elapsed_sec", 0.0) or 0.0),
        required=float(payload.get("hold_required_sec", 3.0) or 3.0),
    )
)
' || true
        fi
    fi
done


echo
echo "===== TEST SUPERVISOR RESULT ====="

if [[ -f "$RESULT_FILE" ]]; then
    cat "$RESULT_FILE" | python3 -m json.tool
else
    echo "No supervisor result file."
    echo "Result detected from runtime: $FINAL_RESULT"
fi


echo
echo "===== RELEVANT ROVER LOG ====="

sed -n "${START_LINE},\$p" "$LOG_FILE" |
grep -E \
    "STRAIGHT SEGMENT GOAL|SEGMENT ALIGNMENT|SEGMENT ALIGNED|ABSOLUTE YAW PIVOT|50MM LOOKAHEAD|EXACT MARKING CONVERGENCE|MARKING CAPTURE|MARKING FINAL|Holding at marking|Marking P|completed|MISSION COMPLETED|SAFE HOLD|ERROR" |
tail -n 400 || true


if [[ "$FINAL_RESULT" == "PASS" ]]; then
    exit 0
fi

exit 1
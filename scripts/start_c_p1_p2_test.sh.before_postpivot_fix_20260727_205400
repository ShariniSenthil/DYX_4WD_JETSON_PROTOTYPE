)"
RPP_PIVOT_RELEASE="$(
    ros2 param get \
        /rpp_controller \
        pivot_exit_angle_deg
)"
RPP_PATH_CORRECTION="$(
    ros2 param get \
        /rpp_controller \
        path_correction_limit_deg
)"
RPP_SEGMENT_CORRECTION="$(
    ros2 param get \
        /rpp_controller \

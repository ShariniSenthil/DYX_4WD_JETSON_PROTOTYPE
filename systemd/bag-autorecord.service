[Unit]
Description=DYX 4WD auto rosbag recorder (mission start to complete)
Documentation=file:/home/flash/rover_ws/scripts/bag_autorecord.py
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=10
# Observer only. Do not PartOf the rover launch — a recorder crash must
# never stop MAVROS, mission_manager, or rover_backend.

[Service]
Type=exec
User=flash
Group=flash
WorkingDirectory=/home/flash/rover_ws
ExecStart=/home/flash/rover_ws/scripts/bag_autorecord.sh
Restart=on-failure
RestartSec=5

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/flash/.ros /home/flash/bags_jet /tmp /var/tmp
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
PrivateTmp=no
LimitNOFILE=65536
MemoryMax=1G
CPUQuota=100%

Environment=ROS_DOMAIN_ID=0
Environment=ROS_LOCALHOST_ONLY=0
Environment=HOME=/home/flash
Environment=BAGS_DIR=/home/flash/bags_jet
EnvironmentFile=-/home/flash/rover_ws/config/bag_autorecord.env

StandardOutput=journal
StandardError=journal
SyslogIdentifier=bag-autorecord

KillMode=mixed
KillSignal=SIGTERM
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target

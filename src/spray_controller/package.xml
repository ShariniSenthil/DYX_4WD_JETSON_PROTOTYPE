  <version>1.0.0</version>
  <description>
    Production PX4 AUX5 spray servo controller for the DYX marking rover.
  </description>

  <maintainer email="flash@todo.todo">flash</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>


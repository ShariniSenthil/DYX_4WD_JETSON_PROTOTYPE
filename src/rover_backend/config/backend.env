# Production copy:
# /etc/dyx-rover-backend.env

DYX_ROVER_ID=dyx-4wd-001
DYX_ROVER_NAME=DYX 4WD Rover

DYX_ROVER_IP=192.168.3.101

DYX_BACKEND_HOST=0.0.0.0
DYX_BACKEND_PORT=5001

DYX_LOG_LEVEL=info

DYX_ALLOWED_SUBNETS=127.0.0.0/8,192.168.3.0/24

DYX_STATIC_USERNAME=admin
DYX_STATIC_PASSWORD=dyx@2026

DYX_SESSION_TTL_SECONDS=315360000
DYX_MAXIMUM_ACTIVE_SESSIONS=5

DYX_MISSION_FILE=/home/flash/rover_ws/missions/mission.csv

DYX_MAXIMUM_UPLOAD_BYTES=5242880

DYX_EXTENSION_TRIGGER_DISTANCE_M=2.0

DYX_TELEMETRY_BROADCAST_HZ=50.0

DYX_SOCKET_PATH=/socket.io

DYX_CORS_ORIGINS=

# GCS discovery: tablet listens on UDP 5002.
DYX_BEACON_ENABLE=true
DYX_BEACON_PORT=5002
DYX_BEACON_INTERVAL_SEC=2.0

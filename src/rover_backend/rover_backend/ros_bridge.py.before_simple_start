    def _mission_status_callback(
        self,
        message: String,
    ) -> None:
        self._mark_ros_message()

        payload = _json_object(message.data)
        if payload is None:
            return

        state_name = str(payload.get("state", "EMPTY")).strip().upper()

        execution_mode = (
            str(
                payload.get(
                    "execution_mode",
                    self._mission_execution_mode,
                )
            )
            .strip()
            .upper()
        )

        if execution_mode not in {"AUTO", "MANUAL"}:
            execution_mode = self._mission_execution_mode

        manager_ready = bool(payload.get("path_ready", False)) and bool(
            payload.get(
                "trajectory_ready",
                False,
            )
        )

        with self._runtime_lock:
            self._mission_manager_state = state_name
            self._mission_execution_mode = execution_mode

            self._mission_manager_ready = state_name == "READY" and manager_ready

            self._mission_manager_error = (
                str(
                    payload.get("error")
                    or payload.get("message")
                    or "Mission manager error"
                )
                if state_name == "ERROR"
                else None
            )

        completed = max(
            0,
            _safe_int(
                payload.get("completed_points"),
                0,
            ),
        )
        skipped = max(
            0,
            _safe_int(
                payload.get("skipped_points"),
                0,
            ),
        )
        failed = max(
            0,
            _safe_int(
                payload.get("failed_points"),
                0,
            ),
        )
        total = max(
            0,
            _safe_int(
                payload.get("total_points"),
                0,
            ),
        )

        point_index_raw = payload.get("current_point_index")
        point_index = (
            _safe_int(point_index_raw) if point_index_raw is not None else None
        )

        mission_updates: dict[str, Any] = {
            "state": state_name,
            "execution_mode": execution_mode,
            "ready": bool(payload.get("path_ready", False)),
            "total_points": total,
            "navigation_point_count": max(
                0,
                _safe_int(
                    payload.get("navigation_point_count"),
                    0,
                ),
            ),
            "active_point_id": payload.get("current_point_id"),
            "active_point_index": point_index,
            "active_point_number": (
                point_index + 1 if point_index is not None else None
            ),
            "active_point_state": payload.get("current_point_state"),
            "completed_points": completed,
            "skipped_points": skipped,
            "failed_points": failed,
            "remaining_points": max(
                0,
                _safe_int(
                    payload.get("remaining_points"),
                    0,
                ),
            ),
            "progress_percent": (
                _finite_float(
                    payload.get("progress_percent"),
                    0.0,
                )
                or 0.0
            ),
            "marking_active": bool(payload.get("marking_active", False)),
            "hold_elapsed_sec": max(
                0.0,
                _finite_float(
                    payload.get("hold_elapsed_sec"),
                    0.0,
                )
                or 0.0,
            ),
            "hold_required_sec": max(
                0.0,
                _finite_float(
                    payload.get("hold_required_sec"),
                    settings.marking_hold_seconds,
                )
                or settings.marking_hold_seconds,
            ),
            "alignment_active": bool(
                payload.get(
                    "alignment_active",
                    False,
                )
            ),
            "point_status": payload.get(
                "point_status",
                [],
            ),
            "message": payload.get("message"),
            "error": payload.get("error"),
        }

        if state_name == "RUNNING":
            current = rover_state.section("mission")
            if current.get("started_at") is None:
                mission_updates["started_at"] = utc_now_iso()

        elif state_name == "PAUSED":
            mission_updates["paused_at"] = utc_now_iso()

        elif state_name == "WAITING_FOR_NEXT":
            mission_updates["paused_at"] = None

        elif state_name == "COMPLETED":
            mission_updates["completed_at"] = utc_now_iso()

        rover_state.update(
            "mission",
            **mission_updates,
        )

        # These manager states must never allow drive commands.
        # WAITING_FOR_NEXT is a live MANUAL hold: mission progress remains
        # loaded and PX4 may remain armed/OFFBOARD, but motion is gated off.
        if state_name in {
            "PAUSED",
            "WAITING_FOR_NEXT",
            "COMPLETED",
            "ERROR",
        }:
            with self._command_lock:
                motion_enabled = bool(self._mission_enable)
                emergency_stop = bool(self._emergency_stop)

            if motion_enabled:
                self.set_safety(
                    emergency_stop=emergency_stop,
                    mission_enable=False,
                    reason=f"MISSION_MANAGER_{state_name}",
                )

        self._persist_mission_runtime(payload)

    def _point_event_callback(
        self,
        message: String,
    ) -> None:
        """
        Store the mission point event together with the backend
        accuracy snapshot for that exact marking point.

        This callback does not change mission control logic.
        """

        self._mark_ros_message()

        payload = _json_object(message.data)
        if payload is None:
            return

        payload["received_at"] = utc_now_iso()

        event_name = str(payload.get("event") or "").strip().upper()

        point_index_raw = payload.get("point_index")

        point_index = (
            _safe_int(
                point_index_raw,
                -1,
            )
            if point_index_raw is not None
            else -1
        )

        point_number = point_index + 1 if point_index >= 0 else 0

        accuracy = rover_state.section("accuracy")

        accuracy_available = bool(
            accuracy.get(
                "available",
                False,
            )
        )

        accuracy_goal_number = _safe_int(
            accuracy.get("goal_number"),
            0,
        )

        accuracy_matches_point = point_number > 0 and (
            accuracy_goal_number == 0 or accuracy_goal_number == point_number
        )

        should_capture_accuracy = (
            event_name
            in {
                "REACHED",
                "MARKED",
            }
            and accuracy_available
            and accuracy_matches_point
        )

        if should_capture_accuracy:
            accuracy_snapshot = {
                "available": True,
                "goal_number": accuracy_goal_number,
                "cross_track_error_mm": accuracy.get("cross_track_error_mm"),
                "cross_track_abs_mm": accuracy.get("cross_track_abs_mm"),
                "cross_track_side": accuracy.get("cross_track_side"),
                "front_back_error_mm": accuracy.get("front_back_error_mm"),
                "front_back_abs_mm": accuracy.get("front_back_abs_mm"),
                "front_back_position": accuracy.get("front_back_position"),
                "radial_error_mm": accuracy.get("radial_error_mm"),
                "closest_radial_error_mm": accuracy.get("closest_radial_error_mm"),
                "accuracy_target_mm": accuracy.get("accuracy_target_mm"),
                "test_tolerance_mm": accuracy.get("test_tolerance_mm"),
                "accuracy_status": accuracy.get("accuracy_status"),
                "accuracy_pass": bool(
                    accuracy.get(
                        "accuracy_pass",
                        False,
                    )
                ),
                "within_test_tolerance": bool(
                    accuracy.get(
                        "within_test_tolerance",
                        False,
                    )
                ),
                "captured_at": utc_now_iso(),
            }

            payload["accuracy"] = accuracy_snapshot
            payload.update(accuracy_snapshot)

        rover_state.update(
            "mission",
            last_point_event=payload,
        )


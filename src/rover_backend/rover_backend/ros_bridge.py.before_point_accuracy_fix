    # ==========================================================
    # Safety and heartbeat publication
    # ==========================================================

    def _publish_safety(self) -> None:
        with self._command_lock:
            mission_enable = bool(self._mission_enable)
            emergency_stop = bool(self._emergency_stop)

        mission_message = Bool()
        mission_message.data = mission_enable
        self._mission_enable_pub.publish(mission_message)

        estop_message = Bool()
        estop_message.data = emergency_stop
        self._emergency_stop_pub.publish(estop_message)

        heartbeat_healthy = bool(
            rover_state.section("safety").get(
                "backend_heartbeat_healthy",
                False,
            )
        )

        rover_state.set_safety_state(
            emergency_stop=emergency_stop,
            mission_enable=mission_enable,
            command_owner=("MISSION" if mission_enable else "NONE"),
            reason=(
                "MISSION_ENABLED"
                if mission_enable
                else ("EMERGENCY_STOP" if emergency_stop else "MISSION_DISABLED")
            ),
            heartbeat_healthy=(heartbeat_healthy),
        )

    def _publish_heartbeat(self) -> None:
        self._heartbeat_sequence = (self._heartbeat_sequence + 1) % (2**64)

        message = UInt64()
        message.data = int(self._heartbeat_sequence)

        self._heartbeat_pub.publish(message)

        rover_state.update(
            "ros",
            last_heartbeat_at=utc_now_iso(),
        )

    def set_safety(
        self,
        *,
        emergency_stop: bool,
        mission_enable: bool,
        reason: str,
    ) -> None:
        emergency_stop = bool(emergency_stop)
        mission_enable = bool(mission_enable)

        if emergency_stop:
            mission_enable = False

        with self._command_lock:
            self._emergency_stop = emergency_stop
            self._mission_enable = mission_enable

        self._publish_safety()

        rover_state.update(
            "safety",
            reason=str(reason),
        )

    def force_safe_state(
        self,
        reason: str,
    ) -> None:
        self.set_safety(
            emergency_stop=True,
            mission_enable=False,
            reason=reason,
        )
        rover_state.force_safe_runtime_state(reason)

    # ==========================================================
    # Service-call helpers
    # ==========================================================

    def _call_service(
        self,
        *,
        client: Any,
        request: Any,
        service_name: str,
        success_attribute: str = "success",
        discovery_timeout_sec: float | None = None,
        response_timeout_sec: float | None = None,
    ) -> tuple[bool, str]:
        discovery_timeout = (
            self.SERVICE_DISCOVERY_TIMEOUT_SEC
            if discovery_timeout_sec is None
            else float(discovery_timeout_sec)
        )
        response_timeout = (
            self.SERVICE_RESPONSE_TIMEOUT_SEC
            if response_timeout_sec is None
            else float(response_timeout_sec)
        )

        if not client.wait_for_service(timeout_sec=discovery_timeout):
            return (
                False,
                f"ROS service unavailable: {service_name}",
            )

        completion = threading.Event()
        response_holder: dict[str, Any] = {}

        try:
            future = client.call_async(request)
        except Exception as error:
            return (
                False,
                f"Unable to call {service_name}: {error}",
            )

        def _done_callback(
            completed_future: Any,
        ) -> None:
            try:
                response_holder["response"] = completed_future.result()
            except Exception as error:
                response_holder["error"] = str(error)
            finally:
                completion.set()

        future.add_done_callback(_done_callback)

        if not completion.wait(response_timeout):
            return (
                False,
                f"Timed out waiting for {service_name}",
            )

        if "error" in response_holder:
            return (
                False,
                f"{service_name} failed: " f"{response_holder['error']}",
            )

        response = response_holder.get("response")

        if response is None:
            return (
                False,
                f"{service_name} returned no response",
            )

        accepted = bool(
            getattr(
                response,
                success_attribute,
                False,
            )
        )

        message = str(
            getattr(
                response,
                "message",
                "OK" if accepted else "Rejected",
            )
        )

        return accepted, message

    def _call_trigger(
        self,
        *,
        client: Any,
        service_name: str,
        response_timeout_sec: float | None = None,
    ) -> tuple[bool, str]:
        return self._call_service(
            client=client,
            request=Trigger.Request(),
            service_name=service_name,
            response_timeout_sec=(response_timeout_sec),
        )

    def _manager_command(
        self,
        command: str,
    ) -> tuple[bool, str]:
        if command not in MISSION_MANAGER_COMMANDS:
            return (
                False,
                f"Unknown mission command: {command}",
            )

        return self._call_trigger(
            client=(self._mission_manager_clients[command]),
            service_name=(f"/mission_manager/{command}"),
        )

    # ==========================================================
    # PX4 helpers and start-health validation
    # ==========================================================

    def _request_px4_mode(
        self,
        mode: str,
    ) -> None:
        request = SetMode.Request()
        request.base_mode = 0
        request.custom_mode = str(mode).strip().upper()

        accepted, message = self._call_service(
            client=self._mode_client,
            request=request,
            service_name="/mavros/set_mode",
            success_attribute="mode_sent",
        )

        if not accepted:
            raise RuntimeError(message)

    def _request_arm(
        self,
        arm: bool,
    ) -> None:
        request = CommandBool.Request()
        request.value = bool(arm)

        accepted, message = self._call_service(
            client=self._arming_client,
            request=request,
            service_name="/mavros/cmd/arming",
            success_attribute="success",
        )

        if not accepted:
            raise RuntimeError(message)

    def _require_start_health(self) -> None:
        if not self._trajectory_ready:
            raise RuntimeError("Trajectory is not ready")

        if (
            not self._fcu_connected
            or self._monotonic_age(self._last_fcu_message_monotonic)
            > self.FCU_STATE_STALE_SEC
        ):
            raise RuntimeError("PX4/MAVROS is disconnected or stale")

        if (
            self._monotonic_age(self._last_position_message_monotonic)
            > self.POSITION_STALE_SEC
        ):
            raise RuntimeError("Local position is unavailable or stale")

        if self._gps_fix_type != 6:
            raise RuntimeError("RTK FIXED is required before mission start")

        if (
            not self._rtk_healthy
            or self._monotonic_age(self._last_rtk_message_monotonic)
            > self.RTK_STATUS_STALE_SEC
        ):
            raise RuntimeError("RTK correction stream is unhealthy or stale")

        correction_age = self._rtk_correction_age_sec

        if (
            correction_age is None
            or correction_age < 0.0
            or correction_age > self.MAX_RTK_CORRECTION_AGE_SEC
        ):
            raise RuntimeError("RTK correction age is not acceptable")

    def _best_effort_px4_safe_cleanup(
        self,
    ) -> list[str]:
        warnings: list[str] = []

        try:
            if self._armed:
                self._request_arm(False)
        except RuntimeError as error:
            warnings.append(f"Disarm warning: {error}")

        try:
            if self._mode != "MANUAL":
                self._request_px4_mode("MANUAL")
        except RuntimeError as error:
            warnings.append(f"MANUAL-mode warning: {error}")

        return warnings

    # ==========================================================
    # Public mission operations used by API routes
    # ==========================================================

    def prepare_trajectory(
        self,
    ) -> dict[str, Any]:
        with self._runtime_lock:
            self._trajectory_ready = False
            self._trajectory_error = None

        rover_state.set_mission_state(
            "PREPARING",
            message=("Trajectory preparation requested"),
            error=None,
        )

        accepted, service_message = self._call_trigger(
            client=(self._trajectory_prepare_client),
            service_name=("/trajectory_generator/prepare"),
        )

        if not accepted:
            rover_state.set_mission_state(
                "ERROR",
                message=service_message,
                error=service_message,
            )
            raise RuntimeError(service_message)

        deadline = time.monotonic() + settings.trajectory_prepare_timeout_seconds

        while time.monotonic() < deadline:
            with self._runtime_lock:
                ready = self._trajectory_ready
                error = self._trajectory_error

            if ready:
                return rover_state.section("mission")

            if error:
                rover_state.set_mission_state(
                    "ERROR",
                    message=error,
                    error=error,
                )
                raise RuntimeError(error)

            time.sleep(0.10)

        timeout_message = "Timed out waiting for trajectory preparation"

        rover_state.set_mission_state(
            "ERROR",
            message=timeout_message,
            error=timeout_message,
        )

        raise RuntimeError(timeout_message)

    def _wait_for_mission_manager_ready(
        self,
    ) -> None:
        deadline = time.monotonic() + settings.trajectory_prepare_timeout_seconds

        while time.monotonic() < deadline:
            with self._runtime_lock:
                state_name = self._mission_manager_state

                ready = self._mission_manager_ready

                error = self._mission_manager_error

            if state_name == "READY" and ready:
                return

            if state_name == "ERROR":
                raise RuntimeError(
                    error or ("Mission manager rejected " "the rebuilt trajectory")
                )

            time.sleep(0.05)

        raise RuntimeError(
            "Timed out waiting for mission manager " "to accept the rebuilt trajectory"
        )

    def start_mission(
        self,
    ) -> dict[str, Any]:
        # Verify RTK, local position and PX4 health before rebuilding.
        self._require_start_health()

        self.get_logger().warn(
            "MISSION START: rebuilding trajectory " "from current rover position"
        )

        # Remove the previous mission-manager READY observation.
        with self._runtime_lock:
            self._mission_manager_state = "PREPARING"

            self._mission_manager_ready = False
            self._mission_manager_error = None

        # This calls /trajectory_generator/prepare again.
        # The trajectory generator reads the latest local odometry,
        # so /nav_path begins at the rover's current position.
        self.prepare_trajectory()

        # Wait until mission_manager accepts the new /nav_path,
        # marking points, path types and marking indices.
        self._wait_for_mission_manager_ready()

        # Preparation may take several seconds, so verify health again.
        self._require_start_health()

        accepted, service_message = self._manager_command("start")

        if not accepted:
            raise RuntimeError(service_message)

        try:
            # Keep motion disabled while PX4 changes mode and arms.
            self.set_safety(
                emergency_stop=False,
                mission_enable=False,
                reason="MISSION_START_PREPARATION",
            )

            # cmd_vel_bridge continuously sends safe zero setpoints, so this
            # short delay gives PX4 an OFFBOARD setpoint stream before mode
            # switching.
            time.sleep(self.OFFBOARD_STREAM_SETTLE_SEC)

            if self._mode != "OFFBOARD":
                self._request_px4_mode("OFFBOARD")

            if not self._armed:
                self._request_arm(True)

            self.set_safety(
                emergency_stop=False,
                mission_enable=True,
                reason="MISSION_RUNNING",
            )

        except Exception:
            self.force_safe_state("MISSION_START_FAILED")
            self._best_effort_px4_safe_cleanup()
            raise

        rover_state.set_mission_state(
            "RUNNING",
            message="Mission started",
            error=None,
            started_at=utc_now_iso(),
        )

        return rover_state.section("mission")

    def pause_mission(
        self,
    ) -> dict[str, Any]:
        # Disable movement before asking the manager to pause.
        self.set_safety(
            emergency_stop=False,
            mission_enable=False,
            reason="MISSION_PAUSE_REQUESTED",
        )

        time.sleep(self.COMMAND_SETTLE_SEC)

        accepted, service_message = self._manager_command("pause")

        if not accepted:
            raise RuntimeError(service_message)

        rover_state.set_mission_state(
            "PAUSED",
            message="Mission paused",
            error=None,
            paused_at=utc_now_iso(),
        )

        return rover_state.section("mission")

    def resume_mission(
        self,
    ) -> dict[str, Any]:
        self._require_start_health()

        accepted, service_message = self._manager_command("resume")

        if not accepted:
            raise RuntimeError(service_message)

        try:
            self.set_safety(
                emergency_stop=False,
                mission_enable=False,
                reason="MISSION_RESUME_PREPARATION",
            )

            time.sleep(self.OFFBOARD_STREAM_SETTLE_SEC)

            if self._mode != "OFFBOARD":
                self._request_px4_mode("OFFBOARD")

            if not self._armed:
                self._request_arm(True)

            self.set_safety(
                emergency_stop=False,
                mission_enable=True,
                reason="MISSION_RUNNING",
            )

        except Exception:
            self.force_safe_state("MISSION_RESUME_FAILED")
            self._best_effort_px4_safe_cleanup()
            raise

        rover_state.set_mission_state(
            "RUNNING",
            message="Mission resumed",
            error=None,
        )

        return rover_state.section("mission")

    def _safe_point_command(
        self,
        command: str,
    ) -> dict[str, Any]:
        was_enabled = bool(self._mission_enable)

        self.set_safety(
            emergency_stop=False,
            mission_enable=False,
            reason=f"{command.upper()}_REQUESTED",
        )

        time.sleep(self.COMMAND_SETTLE_SEC)

        accepted, service_message = self._manager_command(command)

        if not accepted:
            if was_enabled:
                self.set_safety(
                    emergency_stop=False,
                    mission_enable=True,
                    reason="MISSION_RUNNING",
                )
            raise RuntimeError(service_message)

        if was_enabled:
            self.set_safety(
                emergency_stop=False,
                mission_enable=True,
                reason="MISSION_RUNNING",
            )

        return rover_state.section("mission")

    def next_point(
        self,
    ) -> dict[str, Any]:
        return self._safe_point_command("next_point")

    def skip_point(
        self,
    ) -> dict[str, Any]:
        return self._safe_point_command("skip_point")

    def stop_mission(
        self,
    ) -> dict[str, Any]:
        self.force_safe_state("MISSION_STOP_REQUESTED")

        accepted, service_message = self._manager_command("stop")

        cleanup_warnings = self._best_effort_px4_safe_cleanup()

        if not accepted:
            raise RuntimeError(service_message)

        rover_state.clear_mission_runtime(retain_loaded_file=True)

        rover_state.update(
            "mission",
            state="EMPTY",
            loaded=True,
            ready=False,
            message=("Mission stopped; mission.csv retained"),
            stop_warnings=cleanup_warnings,
        )

        return rover_state.section("mission")

    def clear_mission(
        self,
    ) -> dict[str, Any]:
        self.force_safe_state("MISSION_CLEAR_REQUESTED")

        manager_ok, manager_message = self._manager_command("clear")

        trajectory_ok, trajectory_message = self._call_trigger(
            client=(self._trajectory_clear_client),
            service_name=("/trajectory_generator/clear"),
        )

        with self._runtime_lock:
            self._trajectory_ready = False
            self._trajectory_error = None

        if not manager_ok:
            raise RuntimeError(manager_message)

        if not trajectory_ok:
            raise RuntimeError(trajectory_message)

        rover_state.clear_mission_runtime(retain_loaded_file=True)

        return rover_state.section("mission")

    def emergency_stop(
        self,
    ) -> dict[str, Any]:
        self.force_safe_state("OPERATOR_EMERGENCY_STOP")

        return rover_state.section("safety")

    def release_emergency_stop(
        self,
    ) -> dict[str, Any]:
        # Releasing E-stop never starts or resumes a mission.
        self.set_safety(
            emergency_stop=False,
            mission_enable=False,
            reason="EMERGENCY_STOP_RELEASED",
        )

        return rover_state.section("safety")


class RosBridgeRuntime:
    """Start and stop the backend ROS executor in a dedicated thread."""

    def __init__(self) -> None:
        self._lock = threading.RLock()
        self._operation_lock = threading.RLock()
        self._node: RoverBackendRosNode | None = None
        self._executor: MultiThreadedExecutor | None = None
        self._thread: threading.Thread | None = None

    @property
    def node(self) -> RoverBackendRosNode:
        with self._lock:
            if self._node is None:
                raise RuntimeError("ROS bridge is not running")

            return self._node

    @property
    def running(self) -> bool:
        with self._lock:
            return bool(
                self._thread is not None
                and self._thread.is_alive()
                and self._node is not None
            )

    def start(self) -> None:
        with self._lock:
            if self.running:
                return

            if not rclpy.ok():
                rclpy.init(args=None)

            node = RoverBackendRosNode()
            executor = MultiThreadedExecutor(num_threads=4)
            executor.add_node(node)

            thread = threading.Thread(
                target=executor.spin,
                name="rover-backend-ros-spin",
                daemon=True,
            )

            self._node = node
            self._executor = executor
            self._thread = thread

            thread.start()

    def stop(self) -> None:
        with self._lock:
            node = self._node
            executor = self._executor
            thread = self._thread

            self._node = None
            self._executor = None
            self._thread = None

        if node is not None:
            try:
                node.force_safe_state("BACKEND_SHUTDOWN")

                # Publish safety repeatedly before stopping the ROS executor.
                for _ in range(3):
                    node._publish_safety()
                    time.sleep(0.05)

            except Exception:
                LOGGER.exception("Unable to publish backend shutdown safety state")

        if executor is not None:
            try:
                executor.shutdown(timeout_sec=2.0)
            except Exception:
                LOGGER.exception("ROS executor shutdown failed")

        if thread is not None:
            thread.join(timeout=2.0)

        if node is not None:
            try:
                node.destroy_node()
            except Exception:
                LOGGER.exception("ROS node destruction failed")

        if rclpy.ok():
            rclpy.shutdown()

        rover_state.update(
            "ros",
            node_started=False,
            connected=False,
            error="Backend ROS bridge stopped",
        )
        rover_state.force_safe_runtime_state("BACKEND_ROS_BRIDGE_STOPPED")

    def force_emergency_stop(self) -> dict[str, Any]:
        with self._operation_lock:
            return self.node.emergency_stop()

    def release_emergency_stop(self) -> dict[str, Any]:
        with self._operation_lock:
            return self.node.release_emergency_stop()

    def prepare_trajectory(self) -> dict[str, Any]:
        with self._operation_lock:
            return self.node.prepare_trajectory()

    def start_mission(self) -> dict[str, Any]:
        with self._operation_lock:
            return self.node.start_mission()

    def pause_mission(self) -> dict[str, Any]:
        with self._operation_lock:
            return self.node.pause_mission()

    def resume_mission(self) -> dict[str, Any]:
        with self._operation_lock:
            return self.node.resume_mission()

    def next_point(self) -> dict[str, Any]:
        with self._operation_lock:
            return self.node.next_point()

    def skip_point(self) -> dict[str, Any]:
        with self._operation_lock:
            return self.node.skip_point()

    def stop_mission(self) -> dict[str, Any]:
        with self._operation_lock:
            return self.node.stop_mission()

    def clear_mission(self) -> dict[str, Any]:
        with self._operation_lock:
            return self.node.clear_mission()


ros_bridge = RosBridgeRuntime()

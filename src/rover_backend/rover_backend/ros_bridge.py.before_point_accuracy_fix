    def _persist_mission_runtime(
        self,
        manager_payload: dict[str, Any],
    ) -> None:
        runtime_payload = {
            "schema_version": 1,
            "saved_at": utc_now_iso(),
            "mission_id": rover_state.section("mission").get("mission_id"),

#!/usr/bin/env python3

import base64
import socket
import time

import rclpy
from rclpy.node import Node

from mavros_msgs.msg import RTCM


class NtripToPx4Node(Node):

    def __init__(self):
        super().__init__('ntrip_to_px4_node')

        self.declare_parameter('caster_host', 'caster.emlid.com')
        self.declare_parameter('caster_port', 2101)
        self.declare_parameter('mountpoint', 'YOUR_MOUNTPOINT')
        self.declare_parameter('username', 'YOUR_USERNAME')
        self.declare_parameter('password', 'YOUR_PASSWORD')
        self.declare_parameter('rtcm_topic', '/mavros/gps_rtk/send_rtcm')

        self.caster_host = self.get_parameter('caster_host').value
        self.caster_port = int(self.get_parameter('caster_port').value)
        self.mountpoint = self.get_parameter('mountpoint').value
        self.username = self.get_parameter('username').value
        self.password = self.get_parameter('password').value
        self.rtcm_topic = self.get_parameter('rtcm_topic').value

        self.pub = self.create_publisher(RTCM, self.rtcm_topic, 10)

        self.get_logger().warn('========== NTRIP TO PX4 NODE STARTED ==========')
        self.get_logger().warn(f'Caster: {self.caster_host}:{self.caster_port}')
        self.get_logger().warn(f'Mountpoint: {self.mountpoint}')
        self.get_logger().warn(f'RTCM topic: {self.rtcm_topic}')

    def build_request(self):
        user_pass = f'{self.username}:{self.password}'
        auth = base64.b64encode(user_pass.encode()).decode()

        request = (
            f'GET /{self.mountpoint} HTTP/1.0\r\n'
            f'Host: {self.caster_host}\r\n'
            f'User-Agent: NTRIP JetsonPX4/1.0\r\n'
            f'Authorization: Basic {auth}\r\n'
            f'Ntrip-Version: Ntrip/2.0\r\n'
            f'Connection: close\r\n'
            f'\r\n'
        )

        return request.encode()

    def connect_to_caster(self):
        sock = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
        sock.settimeout(10.0)
        sock.connect((self.caster_host, self.caster_port))

        sock.sendall(self.build_request())

        response = sock.recv(1024)

        if b'200' not in response and b'ICY 200 OK' not in response:
            self.get_logger().error('NTRIP caster rejected connection')
            self.get_logger().error(response.decode(errors='ignore'))
            sock.close()
            return None

        self.get_logger().warn('NTRIP caster connected successfully')
        sock.settimeout(2.0)
        return sock

    def publish_rtcm_chunk(self, data):
        if not data:
            return

        msg = RTCM()
        msg.data = list(data)
        self.pub.publish(msg)

    def run(self):
        while rclpy.ok():
            sock = None

            try:
                sock = self.connect_to_caster()

                if sock is None:
                    time.sleep(5.0)
                    continue

                while rclpy.ok():
                    try:
                        data = sock.recv(180)

                        if not data:
                            self.get_logger().error('NTRIP connection closed by caster')
                            break

                        self.publish_rtcm_chunk(data)

                    except socket.timeout:
                        continue

                    except Exception as e:
                        self.get_logger().error(f'NTRIP receive error: {e}')
                        break

                    rclpy.spin_once(self, timeout_sec=0.0)

            except Exception as e:
                self.get_logger().error(f'NTRIP connection error: {e}')

            finally:
                if sock is not None:
                    sock.close()

            self.get_logger().warn('Reconnecting to NTRIP caster in 5 seconds...')
            time.sleep(5.0)


def main(args=None):
    rclpy.init(args=args)

    node = NtripToPx4Node()

    try:
        node.run()

    except KeyboardInterrupt:
        pass

    finally:
        node.destroy_node()
        rclpy.shutdown()


if __name__ == '__main__':
    main()

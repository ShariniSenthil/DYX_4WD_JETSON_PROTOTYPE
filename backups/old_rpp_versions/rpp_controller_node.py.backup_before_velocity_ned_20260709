#!/usr/bin/env python3

import math

import rclpy
from rclpy.node import Node
from rclpy.qos import QoSProfile, ReliabilityPolicy, HistoryPolicy

from nav_msgs.msg import Odometry
from geometry_msgs.msg import PoseStamped, Twist
from std_msgs.msg import Bool

from tf_transformations import euler_from_quaternion


class RPPController(Node):
    def __init__(self):
        super().__init__('rpp_controller')

        self.current_odom = None
        self.current_yaw = None
        self.target_waypoint = None
        self.last_waypoint_time = None

        self.mission_enabled = False
        self.emergency_stop = True

        self.forward_speed = 0.08
        self.slow_forward_speed = 0.04

        self.heading_gain = 0.80
        self.max_angular_speed = 0.20

        self.pivot_angle_deg = 35.0
        self.slow_turn_angle_deg = 12.0

        self.waypoint_tolerance = 0.50
        self.waypoint_timeout_sec = 5.00

        self.last_log_time = self.get_clock().now()
        self.last_wait_log_time = self.get_clock().now()

        odom_qos = QoSProfile(
            reliability=ReliabilityPolicy.BEST_EFFORT,
            history=HistoryPolicy.KEEP_LAST,
            depth=10,
        )

        self.create_subscription(
            Odometry,
            '/mavros/local_position/odom',
            self.odom_callback,
            odom_qos,
        )

        self.create_subscription(
            PoseStamped,
            '/active_waypoint',
            self.waypoint_callback,
            10,
        )

        self.create_subscription(
            Bool,
            '/mission_enable',
            self.mission_enable_callback,
            10,
        )

        self.create_subscription(
            Bool,
            '/emergency_stop',
            self.emergency_stop_callback,
            10,
        )

        self.cmd_pub = self.create_publisher(
            Twist,
            '/cmd_vel',
            10,
        )

        self.timer = self.create_timer(0.05, self.control_loop)

        self.get_logger().warn("========== SAFE RPP CONTROLLER STARTED ==========")
        self.get_logger().warn("Output: /cmd_vel")
        self.get_logger().warn("IMPORTANT: RPP will NOT publish /cmd_vel while waiting")
        self.get_logger().warn("This prevents PX4 warning beep / unwanted ARM request")
        self.get_logger().warn("Large heading error  = pivot")
        self.get_logger().warn("Medium heading error = slow forward turn")
        self.get_logger().warn("Small heading error  = forward tracking")
        self.get_logger().warn(f"forward_speed={self.forward_speed}")
        self.get_logger().warn(f"slow_forward_speed={self.slow_forward_speed}")
        self.get_logger().warn(f"max_angular_speed={self.max_angular_speed}")
        self.get_logger().warn(f"pivot_angle_deg={self.pivot_angle_deg}")
        self.get_logger().warn(f"slow_turn_angle_deg={self.slow_turn_angle_deg}")
        self.get_logger().warn(f"waypoint_tolerance={self.waypoint_tolerance}")

    def odom_callback(self, msg):
        self.current_odom = msg

        q = msg.pose.pose.orientation
        quat = [q.x, q.y, q.z, q.w]

        _, _, yaw = euler_from_quaternion(quat)
        self.current_yaw = yaw

    def waypoint_callback(self, msg):
        self.target_waypoint = msg
        self.last_waypoint_time = self.get_clock().now()

    def mission_enable_callback(self, msg):
        self.mission_enabled = msg.data

    def emergency_stop_callback(self, msg):
        self.emergency_stop = msg.data

    def normalize_angle_rad(self, angle):
        while angle > math.pi:
            angle -= 2.0 * math.pi

        while angle < -math.pi:
            angle += 2.0 * math.pi

        return angle

    def clamp(self, value, min_value, max_value):
        return max(min(value, max_value), min_value)

    def log_waiting(self, reason):
        now = self.get_clock().now()
        dt = (now - self.last_wait_log_time).nanoseconds / 1e9

        if dt < 1.0:
            return

        self.last_wait_log_time = now

        self.get_logger().info(
            f"WAITING: {reason} | no /cmd_vel published"
        )

    def publish_stop_once(self):
        cmd = Twist()
        cmd.linear.x = 0.0
        cmd.angular.z = 0.0
        self.cmd_pub.publish(cmd)

    def is_waypoint_timeout(self):
        if self.last_waypoint_time is None:
            return True

        now = self.get_clock().now()
        age = (now - self.last_waypoint_time).nanoseconds / 1e9

        return age > self.waypoint_timeout_sec

    def control_loop(self):
        # IMPORTANT:
        # Do NOT publish zero /cmd_vel while waiting.
        # If RPP publishes zero continuously, cmd_vel_bridge thinks command is valid
        # and starts requesting OFFBOARD/ARM. That causes PX4 warning beep.

        if self.emergency_stop:
            self.log_waiting("emergency stop active")
            return

        if not self.mission_enabled:
            self.log_waiting("mission disabled")
            return

        if self.current_odom is None:
            self.log_waiting("waiting for /mavros/local_position/odom")
            return

        if self.current_yaw is None:
            self.log_waiting("waiting for heading")
            return

        if self.target_waypoint is None:
            self.log_waiting("waiting for /active_waypoint")
            return

        if self.is_waypoint_timeout():
            self.log_waiting("active waypoint timeout")
            return

        current_x = self.current_odom.pose.pose.position.x
        current_y = self.current_odom.pose.pose.position.y

        target_x = self.target_waypoint.pose.position.x
        target_y = self.target_waypoint.pose.position.y

        dx = target_x - current_x
        dy = target_y - current_y

        distance = math.sqrt(dx * dx + dy * dy)

        target_yaw = math.atan2(dy, dx)
        heading_error = self.normalize_angle_rad(target_yaw - self.current_yaw)
        heading_error_deg = abs(math.degrees(heading_error))

        angular_cmd = heading_error * self.heading_gain
        angular_cmd = self.clamp(
            angular_cmd,
            -self.max_angular_speed,
            self.max_angular_speed,
        )

        cmd = Twist()

        if distance <= self.waypoint_tolerance:
            cmd.linear.x = 0.0
            cmd.angular.z = 0.0
            status = "WAYPOINT REACHED"

        else:
            if heading_error_deg >= self.pivot_angle_deg:
                cmd.linear.x = 0.0
                cmd.angular.z = angular_cmd
                status = "PIVOT TURNING"

            elif heading_error_deg >= self.slow_turn_angle_deg:
                cmd.linear.x = self.slow_forward_speed
                cmd.angular.z = angular_cmd
                status = "SLOW FORWARD TURNING"

            else:
                cmd.linear.x = self.forward_speed
                cmd.angular.z = angular_cmd
                status = "FORWARD TRACKING"

        self.cmd_pub.publish(cmd)

        now = self.get_clock().now()

        if (now - self.last_log_time).nanoseconds >= 1_000_000_000:
            self.get_logger().info(
                f"{status} | "
                f"pos=({current_x:.2f},{current_y:.2f}) | "
                f"target=({target_x:.2f},{target_y:.2f}) | "
                f"dist={distance:.2f} m | "
                f"yaw={math.degrees(self.current_yaw):.1f} deg | "
                f"target_yaw={math.degrees(target_yaw):.1f} deg | "
                f"err={math.degrees(heading_error):.1f} deg | "
                f"cmd_x={cmd.linear.x:.2f} | "
                f"cmd_z={cmd.angular.z:.2f}"
            )

            self.last_log_time = now


def main(args=None):
    rclpy.init(args=args)

    node = RPPController()

    try:
        rclpy.spin(node)

    except KeyboardInterrupt:
        pass

    finally:
        node.publish_stop_once()
        node.destroy_node()
        rclpy.shutdown()


if __name__ == '__main__':
    main()
